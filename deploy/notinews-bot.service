[Unit]
Description=NotiNews Interactive Telegram Bot
After=network-online.target
Wants=network-online.target
OnFailure=notinews-failure-notify@%n.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/NotiNewsForXiaoming
EnvironmentFile=/root/NotiNewsForXiaoming/.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=npm_config_disturl=https://npmmirror.com/mirrors/node
ExecStart=/usr/local/bin/pnpm start:bot
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
