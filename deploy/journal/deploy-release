#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/sbin:/usr/bin:/sbin:/bin

PROJECT_DIR=/opt/journal
COMPOSE_FILE=${PROJECT_DIR}/compose.yaml
INCOMING_DIR=/var/lib/journal-deploy/incoming
IMAGE_REPOSITORY=notinews-journal
DEPLOY_COMMIT_FILE=${PROJECT_DIR}/.deploy-commit
PREVIOUS_COMMIT_FILE=${PROJECT_DIR}/.previous-deploy-commit
EXPECTED_ARCHIVE_OWNER=journal-deploy

if [[ $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo 'usage: journal-deploy-release <40-character-lowercase-commit-sha>' >&2
  exit 64
fi

RELEASE_SHA=$1
IMAGE_ARCHIVE=${INCOMING_DIR}/journal-${RELEASE_SHA}.tar
IMAGE_REFERENCE=${IMAGE_REPOSITORY}:${RELEASE_SHA}

if [[ ! -f ${IMAGE_ARCHIVE} || -L ${IMAGE_ARCHIVE} ]]; then
  echo "release archive is missing or is not a regular file: ${IMAGE_ARCHIVE}" >&2
  exit 66
fi

if [[ $(stat -c '%U' "${IMAGE_ARCHIVE}") != ${EXPECTED_ARCHIVE_OWNER} ]]; then
  echo "release archive must be owned by ${EXPECTED_ARCHIVE_OWNER}" >&2
  exit 77
fi

docker image load --input "${IMAGE_ARCHIVE}"
rm -- "${IMAGE_ARCHIVE}"
docker image inspect "${IMAGE_REFERENCE}" >/dev/null

CURRENT_SHA=
if [[ -f ${DEPLOY_COMMIT_FILE} ]]; then
  CURRENT_SHA=$(<"${DEPLOY_COMMIT_FILE}")
  if [[ ! ${CURRENT_SHA} =~ ^[0-9a-f]{40}$ ]]; then
    echo "invalid current release marker: ${DEPLOY_COMMIT_FILE}" >&2
    exit 65
  fi
fi

JOURNAL_IMAGE_TAG=${RELEASE_SHA} docker compose \
  --project-name journal \
  --file "${COMPOSE_FILE}" \
  up --detach --no-deps --wait --wait-timeout 90 journal

if [[ -n ${CURRENT_SHA} && ${CURRENT_SHA} != ${RELEASE_SHA} ]]; then
  printf '%s\n' "${CURRENT_SHA}" > "${PREVIOUS_COMMIT_FILE}.new"
  chmod 600 "${PREVIOUS_COMMIT_FILE}.new"
  mv "${PREVIOUS_COMMIT_FILE}.new" "${PREVIOUS_COMMIT_FILE}"
fi

printf '%s\n' "${RELEASE_SHA}" > "${DEPLOY_COMMIT_FILE}.new"
chmod 600 "${DEPLOY_COMMIT_FILE}.new"
mv "${DEPLOY_COMMIT_FILE}.new" "${DEPLOY_COMMIT_FILE}"

PREVIOUS_SHA=
if [[ -f ${PREVIOUS_COMMIT_FILE} ]]; then
  PREVIOUS_SHA=$(<"${PREVIOUS_COMMIT_FILE}")
  if [[ ! ${PREVIOUS_SHA} =~ ^[0-9a-f]{40}$ ]]; then
    echo "invalid previous release marker: ${PREVIOUS_COMMIT_FILE}" >&2
    exit 65
  fi
fi

while IFS= read -r image_tag; do
  if [[ ! ${image_tag} =~ ^[0-9a-f]{40}$ ]]; then
    continue
  fi
  if [[ ${image_tag} == ${RELEASE_SHA} || ${image_tag} == ${PREVIOUS_SHA} ]]; then
    continue
  fi
  docker image rm "${IMAGE_REPOSITORY}:${image_tag}"
done < <(docker image ls "${IMAGE_REPOSITORY}" --format '{{.Tag}}')
