# Telegram Bot 配置
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# Journal 采集配置
JOURNAL_API_BASE_URL=https://feeds.xmcloud.buzz
JOURNAL_INGEST_TOKEN=your_journal_ingest_token
JOURNAL_PUBLIC_BASE_URL=https://feeds.xmcloud.buzz

# 和风天气配置 (https://dev.qweather.com/)
QWEATHER_API_KEY=your_qweather_api_key
# 城市 ID (北京为 101010100，其它城市请查阅和风天气文档)
QWEATHER_CITY_ID=101010100

# DeepSeek API 配置 (可选)
DEEPSEEK_API_KEY=your_deepseek_api_key

# start.gg API 配置
STARTGG_API_TOKEN=your_startgg_api_token
