#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

PROJECT_DIR=/opt/journal
OPENRESTY_ROOT=/opt/1panel/apps/openresty/openresty
OPENRESTY_SITE_CONFIG=${OPENRESTY_ROOT}/conf/conf.d/feeds.xmcloud.buzz.conf
OPENRESTY_SITE_SSL=${OPENRESTY_ROOT}/www/sites/feeds.xmcloud.buzz/ssl
BACKUP_WORK_DIR=/var/lib/journal-backup
REMOTE_ROOT=notinews-drive:NotiNewsBackups/journal
DAILY_REMOTE=${REMOTE_ROOT}/daily
MONTHLY_REMOTE=${REMOTE_ROOT}/monthly
BACKUP_TIMESTAMP=$(TZ=Asia/Shanghai date +%Y-%m-%d-%H%M%S)
BACKUP_DAY=$(TZ=Asia/Shanghai date +%d)
DEPLOY_COMMIT=$(<"${PROJECT_DIR}/.deploy-commit")
BACKUP_NAME=journal-v1-${BACKUP_TIMESTAMP}-${DEPLOY_COMMIT:0:7}.tar.gz
ARCHIVE_PATH=${BACKUP_WORK_DIR}/${BACKUP_NAME}
ARCHIVE_CHECKSUM_PATH=${ARCHIVE_PATH}.sha256
install -d -m 700 "${BACKUP_WORK_DIR}"
STAGING_ROOT=$(mktemp -d "${BACKUP_WORK_DIR}/staging.XXXXXX")
BUNDLE_ROOT=${STAGING_ROOT}/journal-backup-v1
PAYLOAD_ROOT=${BUNDLE_ROOT}/payload
RCLONE_ARGS=(--retries 1 --low-level-retries 1)

cleanup() {
  rm -rf -- "${STAGING_ROOT}"
  rm -f -- "${ARCHIVE_PATH}" "${ARCHIVE_CHECKSUM_PATH}"
}
trap cleanup EXIT

install -d -m 700 \
  "${PAYLOAD_ROOT}/data" \
  "${PAYLOAD_ROOT}/proxy/ssl"

install -m 600 "${PROJECT_DIR}/.env" "${PAYLOAD_ROOT}/app.env"
install -m 600 "${PROJECT_DIR}/.deploy-commit" "${PAYLOAD_ROOT}/deploy-commit"
install -m 600 "${PROJECT_DIR}/compose.yaml" "${PAYLOAD_ROOT}/compose.yaml"
install -m 600 "${OPENRESTY_SITE_CONFIG}" "${PAYLOAD_ROOT}/proxy/site.conf"
cp -a "${PROJECT_DIR}/data/." "${PAYLOAD_ROOT}/data/"
cp -a "${OPENRESTY_SITE_SSL}/." "${PAYLOAD_ROOT}/proxy/ssl/"

{
  echo 'format_version=1'
  echo 'component=journal'
  echo "created_at=$(TZ=Asia/Shanghai date --iso-8601=seconds)"
  echo "git_commit=${DEPLOY_COMMIT}"
  echo "source_hostname=$(hostname)"
  echo 'data_layout=journal-v1'
} > "${BUNDLE_ROOT}/manifest.env"
chmod 600 "${BUNDLE_ROOT}/manifest.env"

(
  cd "${BUNDLE_ROOT}"
  while IFS= read -r -d '' payload_file; do
    sha256sum "${payload_file}"
  done < <(find payload -type f -print0 | LC_ALL=C sort -z)
) > "${BUNDLE_ROOT}/payload.sha256"
chmod 600 "${BUNDLE_ROOT}/payload.sha256"

tar -czf "${ARCHIVE_PATH}" -C "${STAGING_ROOT}" journal-backup-v1
(
  cd "${BACKUP_WORK_DIR}"
  sha256sum "${BACKUP_NAME}" > "${BACKUP_NAME}.sha256"
)

rclone mkdir "${DAILY_REMOTE}" "${RCLONE_ARGS[@]}"
rclone mkdir "${MONTHLY_REMOTE}" "${RCLONE_ARGS[@]}"
rclone copyto "${ARCHIVE_PATH}" "${DAILY_REMOTE}/${BACKUP_NAME}" "${RCLONE_ARGS[@]}"
rclone copyto "${ARCHIVE_CHECKSUM_PATH}" "${DAILY_REMOTE}/${BACKUP_NAME}.sha256" "${RCLONE_ARGS[@]}"

if [[ ${BACKUP_DAY} == 01 ]]; then
  rclone copyto "${ARCHIVE_PATH}" "${MONTHLY_REMOTE}/${BACKUP_NAME}" "${RCLONE_ARGS[@]}"
  rclone copyto "${ARCHIVE_CHECKSUM_PATH}" "${MONTHLY_REMOTE}/${BACKUP_NAME}.sha256" "${RCLONE_ARGS[@]}"
fi

rclone delete "${DAILY_REMOTE}" --min-age 35d "${RCLONE_ARGS[@]}"
rclone delete "${MONTHLY_REMOTE}" --min-age 730d "${RCLONE_ARGS[@]}"
