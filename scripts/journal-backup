#!/usr/bin/env bash
set -euo pipefail

PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

PROJECT_DIR=/opt/journal
OPENRESTY_ROOT=/opt/1panel/apps/openresty/openresty
OPENRESTY_SITE_CONFIG=${OPENRESTY_ROOT}/conf/conf.d/feeds.xmcloud.buzz.conf
OPENRESTY_SITE_SSL=${OPENRESTY_ROOT}/www/sites/feeds.xmcloud.buzz/ssl
BACKUP_WORK_DIR=/var/lib/journal-backup
REMOTE_DIR=notinews-drive:NotiNewsBackups-LongTerm/rndc02-journal
BACKUP_TIMESTAMP=$(TZ=Asia/Shanghai date +%Y-%m-%d-%H%M%S)
BACKUP_NAME=journal-rndc02-${BACKUP_TIMESTAMP}.tar.gz
MANIFEST_PATH=${BACKUP_WORK_DIR}/backup-manifest.txt
ARCHIVE_PATH=${BACKUP_WORK_DIR}/${BACKUP_NAME}
DEPLOY_COMMIT=$(<"${PROJECT_DIR}/.deploy-commit")

install -d -m 700 "${BACKUP_WORK_DIR}"

{
  echo "backup_time=${BACKUP_TIMESTAMP}"
  echo "git_commit=${DEPLOY_COMMIT}"
  echo "hostname=$(hostname)"
  echo "project_dir=${PROJECT_DIR}"
} > "${MANIFEST_PATH}"

tar -czf "${ARCHIVE_PATH}" \
  -C / \
  opt/journal/.env \
  opt/journal/.deploy-commit \
  opt/journal/compose.yaml \
  opt/journal/data \
  "${OPENRESTY_SITE_CONFIG#/}" \
  "${OPENRESTY_SITE_SSL#/}" \
  -C "${BACKUP_WORK_DIR}" \
  backup-manifest.txt

rclone copyto "${ARCHIVE_PATH}" "${REMOTE_DIR}/${BACKUP_NAME}" \
  --retries 1 \
  --low-level-retries 1
rm "${ARCHIVE_PATH}" "${MANIFEST_PATH}"
rclone delete "${REMOTE_DIR}" \
  --min-age 30d \
  --retries 1 \
  --low-level-retries 1
